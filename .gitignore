# --- Environment & API Secrets (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backednya/.env
backednya/.env.local
**/config/keys.json
**/*.pem
**/*.key
gsk_*.txt

# --- Flutter / Dart Build & Generated Files ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
lib/generated/
lib/core/database/*.db
lib/core/database/*.sqlite

# --- Android Specific ---
android/local.properties
android/key.properties
android/app/key.properties
android/app/google-services.json
android/.gradle/
android/app/build/
android/captures/
android/assets/

# --- iOS Specific ---
ios/.DS_Store
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# ==========================================
# PromptStudio AI Git Attributes Normalization
# ==========================================

# Auto detect text files and perform LF normalization on commit
* text=auto

# Force LF line endings for coding and data source files
*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# Denote graphic and documentation binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.db binary
*.sqlite binary
*.jar binary
*.aar binary
